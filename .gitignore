# build artifacts (regenerated by nvcc via each module's build())
/build/
*.o
*.so
build_ctypes/

# python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
.env.*
!.env.example

# generated prefill state (regenerate with nex_n2_5_pro/sglang_prefill/extract_state.py)
prefill_state/
*.pt
*.safetensors

# generated english prompt pool (regenerate with nex_n2_5_pro/prep_english_docs.py)
data_en/

# scratch / dev working dirs
# serve.sh logs + pidfiles (.claude/skills/run-nexrt)
.nexrt-run/
*.log
*.ncu-rep
.DS_Store
nex_n2_5_pro/.tmp_cp/
nex_n2_5_pro/.tmp_sglang/
nex_n2_5_pro/_flash_scratch/

# bridge serving report (nex_n2_5_pro/sglang_prefill/bridge_serve.py, overridable via NEXRT_SERVE_REPORT)
nex_n2_5_pro/serve_report.jsonl
